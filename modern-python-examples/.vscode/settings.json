{
  // 打开本目录时的默认解释器 —— Miniforge 的 py314 环境 (Python 3.14.7)
  // 作用: 右上角 ▶ 按钮、F5、Pylance 类型提示都直接用它, 不用每次手动选
  //
  // 本文件为 macOS 版 (原 Windows 版是 "D:/Miniforge3/envs/py314/python.exe")。
  // 用绝对路径而非 PATH 上的 "python": conda 已设为不自动激活 base,
  // 只有显式 `conda activate py314` 后 PATH 上才有 python。写绝对路径可保证
  // 无论终端处于什么状态, VSCode 都能找到正确的解释器。
  "python.defaultInterpreterPath": "/Users/nalanyian/miniforge3/envs/py314/bin/python",

  // 集成终端里带上 PYTHONUTF8=1
  // macOS 默认已经是 UTF-8, 保留此项是为了与 Windows/其他平台保持一致的写法;
  // 顺便保证 `python f.py > out.txt` 写出来的是 UTF-8。
  "terminal.integrated.env.osx": {
    "PYTHONUTF8": "1"
  }
}
