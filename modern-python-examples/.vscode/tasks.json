{
  // VSCode 任务配置 —— 用法: 打开某个 .py 后按 Ctrl+Shift+B
  //
  // 注意这里只有一个任务。C++ 那边有"只编译/编译并运行/只运行"三个，
  // 因为 C++ 要先编译出 exe 再运行，是两步；Python 是解释执行，一条命令到底。
  //
  // ⚠️ 跟 C++ 一样: 任务作用于"当前焦点所在的编辑器"。焦点停在 README.md 上按快捷键会去跑 README.md。
  "version": "2.0.0",
  "tasks": [
    {
      // ★ 默认任务: Ctrl+Shift+B 触发的就是它
      "label": "Python: 运行当前文件",
      "detail": "python 当前.py (用 PATH 上的 python = Miniforge py314)",
      "type": "shell",
      "command": "python",
      "args": [
        "${file}"
      ],
      "options": {
        // 以文件所在目录为工作目录, 跟手敲时先 cd 过去一致
        "cwd": "${fileDirname}"
      },
      // Python 的报错走 stderr 且没有 $gcc 那种固定格式可解析, 这里不做映射
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
