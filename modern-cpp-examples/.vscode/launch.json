{
  // 按 F5 断点调试当前 .cpp。需要 VSCode 装了 C/C++ 扩展 (ms-vscode.cpptools)
  // 只"想跑一下看输出"的话不用 F5, 用 tasks.json 里的任务更省事
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C++: 调试当前文件 (gdb)",
      "type": "cppdbg",
      "request": "launch",
      // 与 tasks.json 的输出路径保持一致
      "program": "${fileDirname}/${fileBasenameNoExtension}.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${fileDirname}",
      "environment": [],
      // false = 输出显示在 VSCode 的"调试控制台"里, 不另开黑窗
      "externalConsole": false,
      "MIMode": "gdb",
      // 与 g++ 同源 (同为 winlibs 构建), 版本必须匹配, 别改成 Qt 自带的那个 gdb
      "miDebuggerPath": "D:/mingw64/bin/gdb.exe",
      "setupCommands": [
        {
          "description": "启用 gdb 整齐打印 (STL 容器显示成人类可读格式)",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      // 调试前先编译; 注意这里必须是"只编译"那个任务, 不能选"编译并运行"(那样会先跑一遍再调试)
      // 会再弹一次标准选择框 (同 tasks.json 的那个下拉框)
      "preLaunchTask": "C++: 只编译不运行"
    }
  ]
}
