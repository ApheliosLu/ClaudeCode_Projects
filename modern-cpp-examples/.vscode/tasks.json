{
    // VSCode 任务配置 —— 用法: 打开某个 .cpp 后按 Ctrl+Shift+B
    //
    // 本文件为 macOS 版 (原 Windows 版用 MinGW-w64 g++ + cmd.exe)。
    // 迁移要点:
    //   1. 编译器改为 clang++ (macOS 自带, 随 Command Line Tools 安装)
    //   2. 去掉 -static —— macOS 不支持完全静态链接, 加了会链接失败
    //   3. 去掉 -lstdc++exp —— 那是 GCC 特有库, clang/libc++ 没有
    //   4. 去掉 chcp/cmd.exe —— Windows 控制台代码页机制, macOS 无对应概念
    //   5. 输出去掉 .exe 后缀 —— macOS 可执行文件不带扩展名
    "version": "2.0.0",
    "tasks": [
        {
            // ★ 默认任务: Ctrl+Shift+B 触发的就是它
            "label": "C++: 编译并运行当前文件",
            "detail": "★ Ctrl+Shift+B —— 先编译, 成功后运行, 一条命令到底",
            "type": "shell",
            "command": "${fileDirname}/${fileBasenameNoExtension}",
            "dependsOn": "C++: 只编译不运行",
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": false
            }
        },
        {
            "label": "C++: 只编译不运行",
            "detail": "clang++ -std=<下拉选的标准> -Wall -Wextra -O1 -g -pthread 当前.cpp -> 同名可执行文件",
            "type": "shell",
            "command": "clang++",
            "args": [
                "-std=${input:cppStd}",
                "-Wall",
                "-Wextra",
                "-O1",
                "-g",
                "-pthread",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "C++: 只运行 (不重新编译)",
            "detail": "直接跑上次编译出来的可执行文件, 改了代码别用这个",
            "type": "shell",
            "command": "${fileDirname}/${fileBasenameNoExtension}",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: clang++ 生成活动文件",
            "command": "/usr/bin/clang++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "C/C++ 扩展自动生成的编译任务。本项目不用它：它没带 -std=, 编 cpp17+ 会失败。保留是为了让扩展别再重复生成, isDefault 已关掉, Ctrl+Shift+B 不会再走到它。"
        }
    ],
    "inputs": [
        {
            "id": "cppStd",
            "type": "pickString",
            "description": "选这个文件对应的 C++ 标准 (看它所在目录: cpp11 -> c++11, cpp23 -> c++23)",
            "options": [
                "c++11",
                "c++14",
                "c++17",
                "c++20",
                "c++23"
            ],
            "default": "c++11"
        }
    ]
}
